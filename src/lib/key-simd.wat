(module
  (memory (export "memory") 8)
  ;; SIMD color-key: 4 packed RGBA pixels per v128. Zeros lanes whose RGB is within exact of the field.
  (func (export "key4") (param $bytes i32) (param $fr i32) (param $fg i32) (param $fb i32)
    (local $i i32) (local $px v128) (local $r v128) (local $g v128) (local $b v128)
    (local $dr v128) (local $dg v128) (local $db v128) (local $d v128) (local $hit v128)
    (local $ff v128) (local $exact v128) (local $frv v128) (local $fgv v128) (local $fbv v128)
    (local.set $ff (v128.const i32x4 255 255 255 255))
    (local.set $exact (v128.const i32x4 196 196 196 196))
    (local.set $frv (i32x4.splat (local.get $fr)))
    (local.set $fgv (i32x4.splat (local.get $fg)))
    (local.set $fbv (i32x4.splat (local.get $fb)))
    (block $done
      (loop $row
        (br_if $done (i32.ge_u (local.get $i) (local.get $bytes)))
      (local.set $px (v128.load (local.get $i)))
      (local.set $r (v128.and (local.get $px) (local.get $ff)))
      (local.set $g (v128.and (i32x4.shr_u (local.get $px) (i32.const 8)) (local.get $ff)))
      (local.set $b (v128.and (i32x4.shr_u (local.get $px) (i32.const 16)) (local.get $ff)))
      (local.set $dr (i32x4.sub (local.get $r) (local.get $frv)))
      (local.set $dg (i32x4.sub (local.get $g) (local.get $fgv)))
      (local.set $db (i32x4.sub (local.get $b) (local.get $fbv)))
      (local.set $d (i32x4.add (i32x4.add (i32x4.mul (local.get $dr) (local.get $dr)) (i32x4.mul (local.get $dg) (local.get $dg))) (i32x4.mul (local.get $db) (local.get $db))))
      (local.set $hit (i32x4.le_s (local.get $d) (local.get $exact)))
      (v128.store (local.get $i) (v128.and (local.get $px) (v128.not (local.get $hit))))
      (local.set $i (i32.add (local.get $i) (i32.const 16)))
      (br $row)
      )
    )
  )
)
