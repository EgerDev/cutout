{
  "name": "cutout",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8080",
    "dev:lan": "vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/patch-dependencies.mjs --check && vite build",
    "build:dev": "vite build --mode development",
    "build:wasm": "wat2wasm src/lib/key-simd.wat -o src/lib/key-simd.wasm",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"src/**/*.test.ts\" \"server/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"scripts/e2e/*.test.mjs\"",
    "test:server": "node --test scripts/built-server.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf:profile": "node scripts/perf-profile.mjs",
    "icons": "node scripts/render-icon.mjs",
    "postinstall": "node scripts/patch-dependencies.mjs",
    "test:ui": "node --test --test-concurrency=1 scripts/browser-workspace-qol.mjs scripts/browser-stage-lifecycle.mjs scripts/browser-stage-ui.mjs scripts/browser-preview-lifecycle.mjs scripts/browser-metadata.mjs scripts/browser-svg-safety.mjs scripts/browser-storage.mjs scripts/browser-launch-confirm.mjs scripts/browser-unsaved.mjs scripts/browser-unsupported.mjs scripts/browser-interface-recovery.mjs scripts/browser-workspace-queue.mjs scripts/browser-sheet-resize.mjs scripts/browser-model-preparation.mjs scripts/browser-removal-stop.mjs scripts/browser-export-format-keys.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "test:editor": "node --test src/lib/editor/model.test.ts && node --test --test-concurrency=1 scripts/browser-editor-features.mjs scripts/browser-adjust-pipeline.mjs scripts/browser-sheet-export.mjs",
    "test:removal": "node --test src/lib/removal-budget.test.ts src/lib/removal-diagnostics.test.ts && node --test --test-concurrency=1 scripts/browser-adaptive-removal.mjs scripts/browser-engine-refinement.mjs scripts/browser-engine-cancellation.mjs scripts/browser-firefox-worker.mjs scripts/browser-owned-removal.mjs",
    "test:mobile": "node --test --test-concurrency=1 scripts/browser-mobile.mjs",
    "test:csp": "node --test scripts/browser-csp.mjs",
    "test:a11y": "node --test --test-concurrency=1 scripts/browser-a11y.mjs",
    "test:heic": "node --test scripts/browser-heic.mjs",
    "start": "node --env-file-if-exists=.env.production .output/server/index.mjs",
    "test:formats": "node --test --test-concurrency=1 scripts/browser-image-formats.mjs scripts/browser-advanced-exports.mjs scripts/browser-pixels-low.mjs",
    "test:advanced": "node --test --test-concurrency=1 scripts/browser-advanced-tools.mjs scripts/browser-async-recovery.mjs scripts/browser-export-preview.mjs scripts/browser-model-cache.mjs scripts/browser-source-cache.mjs scripts/browser-workspace-cancellation.mjs",
    "test:ui:audit": "node --test --test-concurrency=1 scripts/browser-ui-low.mjs scripts/browser-ui07.mjs",
    "test:routes": "node --test --test-concurrency=1 scripts/browser-page-aliases.mjs",
    "test:ingest:audit": "node --test --test-concurrency=1 scripts/browser-ingest-low.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dxf-parser": "^1.1.2",
    "exifreader": "^4.45.0",
    "fflate": "0.8.3",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "utif2": "^4.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lru-cache": "11.2.6",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.4.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.4"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "onnxruntime-node": "1.30.0",
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
